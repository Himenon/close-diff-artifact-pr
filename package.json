{
  "name": "@himenon/upload-diff-artifact",
  "private": true,
  "license": "./LICENSE.md",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "format": "run-p format:*",
    "format:oxfmt": "oxfmt",
    "format:prettier": "prettier --write **/*.md",
    "postinstall": "lefthook install",
    "test": "vitest"
  },
  "prettier": {
    "semi": true,
    "tabWidth": 2,
    "trailingComma": "all"
  },
  "devDependencies": {
    "lefthook": "^2.0.15",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.24.0",
    "prettier": "^3.8.0",
    "sort-package-json": "^3.6.0"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "24.13.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  }
}
